# Admin login (required)
ADMIN_EMAIL=admin@atlascoast.travel
ADMIN_PASSWORD=change-this-password
AUTH_SECRET=replace-with-a-long-random-secret

# PostgreSQL (server-side only)
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/transferapp?sslmode=disable

# Optional: mark this environment so demo seeding is allowed
ALLOW_DEMO_SEED=true
